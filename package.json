{
  "name": "@nemolize/cc-grep",
  "version": "0.5.0",
  "description": "Cross-project full-text search CLI over Claude Code session transcripts. Run with npx.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemolize/cc-grep.git"
  },
  "bugs": {
    "url": "https://github.com/nemolize/cc-grep/issues"
  },
  "homepage": "https://github.com/nemolize/cc-grep#readme",
  "keywords": [
    "claude",
    "claude-code",
    "grep",
    "search",
    "transcript",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.0",
  "bin": {
    "cc-grep": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint .",
    "lint:knip": "knip",
    "lint:prettier": "prettier --check .",
    "lint:typecheck": "run-p --continue-on-error type-check typecheck:node",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "fix": "run-s --continue-on-error fix:eslint fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
