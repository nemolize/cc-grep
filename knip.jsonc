{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/cli.ts is inferred from the `bin` field, so it is not listed here.
  "entry": ["test/**/*.test.js"],
  "project": ["src/**/*.ts", "test/**/*.js"],
  // Invoked as a command — by the release workflow and by hand — never imported,
  // so knip cannot see it.
  "ignoreDependencies": ["@changesets/cli"],
}
